<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content="Hamburger Rapid: La primera versión comercial de comida rápida fast gourmet. Descubre nuestras 10 variantes destacadas preparadas con ingredientes de alta cocina." />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Playfair+Display:ital,wght@0,700;1,700&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg-primary: #FAFAF7;
      --bg-card: #FFFFFF;
      --bg-surface: #F4F4F0;
      --text-main: #18181B;
      --text-muted: #71717A;
      --border-subtle: #E4E4E7;
      --border-hover: #D4D4D8;
      --primary-red: #DC2626;
      --primary-red-hover: #B91C1C;
      --accent-amber: #D97706;
      --accent-gold: #F59E0B;
      --gold-surface: #FEF3C7;
      --shadow-sm: 0 2px 8px rgba(0,0,0,0.04);
      --shadow-md: 0 10px 25px -4px rgba(0,0,0,0.06), 0 4px 6px -2px rgba(0,0,0,0.03);
      --shadow-lg: 0 20px 35px -5px rgba(0,0,0,0.08), 0 10px 10px -5px rgba(0,0,0,0.03);
      --radius-sm: 10px;
      --radius-md: 16px;
      --radius-lg: 24px;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: 'Plus Jakarta Sans', sans-serif;
      background-color: var(--bg-primary);
      color: var(--text-main);
      line-height: 1.6;
      overflow-x: hidden;
      -webkit-font-smoothing: antialiased;
    }

    /* Top Announcement Bar */
    .top-bar {
      background: linear-gradient(90deg, #991B1B, #DC2626, #B45309);
      color: #FFF;
      text-align: center;
      padding: 0.55rem 1rem;
      font-size: 0.85rem;
      font-weight: 600;
      letter-spacing: 0.02em;
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 1rem;
    }
    .top-bar a {
      color: #FEF08A;
      text-decoration: underline;
      font-weight: 700;
      margin-left: 0.25rem;
    }

    /* Navigation */
    .navbar {
      position: sticky;
      top: 0;
      z-index: 50;
      background: rgba(250, 250, 247, 0.92);
      backdrop-filter: blur(14px);
      border-bottom: 1px solid var(--border-subtle);
      padding: 1rem 2rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .brand-wrap {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      text-decoration: none;
      color: var(--text-main);
    }
    .brand-icon {
      width: 44px;
      height: 44px;
      background: linear-gradient(135deg, #DC2626, #B45309);
      color: white;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.5rem;
      box-shadow: 0 4px 12px rgba(220, 38, 38, 0.25);
    }
    .brand-title {
      font-size: 1.35rem;
      font-weight: 800;
      letter-spacing: -0.02em;
      line-height: 1.1;
    }
    .brand-title span {
      color: var(--primary-red);
    }
    .brand-tag {
      font-size: 0.68rem;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      color: var(--text-muted);
      font-weight: 700;
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: 2rem;
      list-style: none;
    }
    .nav-links a {
      color: var(--text-main);
      text-decoration: none;
      font-size: 0.95rem;
      font-weight: 600;
      transition: color 0.2s;
    }
    .nav-links a:hover {
      color: var(--primary-red);
    }

    .nav-actions {
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }
    .btn-secondary {
      background: #FFFFFF;
      border: 1px solid var(--border-subtle);
      color: var(--text-main);
      padding: 0.6rem 1.1rem;
      border-radius: var(--radius-sm);
      font-size: 0.88rem;
      font-weight: 700;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      transition: all 0.2s;
      box-shadow: var(--shadow-sm);
    }
    .btn-secondary:hover {
      border-color: var(--text-main);
      transform: translateY(-1px);
    }
    .btn-primary {
      background: linear-gradient(135deg, var(--primary-red), #B91C1C);
      color: white;
      border: none;
      padding: 0.65rem 1.3rem;
      border-radius: var(--radius-sm);
      font-size: 0.88rem;
      font-weight: 700;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      box-shadow: 0 4px 14px rgba(220, 38, 38, 0.35);
      transition: all 0.2s;
    }
    .btn-primary:hover {
      box-shadow: 0 6px 18px rgba(220, 38, 38, 0.45);
      transform: translateY(-2px);
    }

    /* Hero Section */
    .hero {
      position: relative;
      max-width: 1280px;
      margin: 0 auto;
      padding: 4.5rem 2rem 3rem;
      display: grid;
      grid-template-columns: 1.15fr 0.85fr;
      align-items: center;
      gap: 3.5rem;
    }
    .hero-eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      background: var(--gold-surface);
      color: var(--accent-amber);
      border: 1px solid #FDE68A;
      padding: 0.4rem 1rem;
      border-radius: 9999px;
      font-size: 0.85rem;
      font-weight: 700;
      margin-bottom: 1.5rem;
    }
    .hero h1 {
      font-family: 'Playfair Display', serif;
      font-size: 3.8rem;
      font-weight: 700;
      line-height: 1.1;
      letter-spacing: -0.02em;
      color: #111827;
      margin-bottom: 1.25rem;
    }
    .hero h1 em {
      font-style: italic;
      color: var(--primary-red);
      font-family: 'Playfair Display', serif;
    }
    .hero p {
      color: var(--text-muted);
      font-size: 1.18rem;
      line-height: 1.65;
      max-width: 580px;
      margin-bottom: 2.25rem;
    }
    .hero-buttons {
      display: flex;
      align-items: center;
      gap: 1rem;
      flex-wrap: wrap;
      margin-bottom: 2.5rem;
    }
    .hero-stats {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
      border-top: 1px solid var(--border-subtle);
      padding-top: 1.75rem;
      max-width: 560px;
    }
    .stat-number {
      font-size: 1.75rem;
      font-weight: 800;
      color: #111827;
      line-height: 1.2;
    }
    .stat-label {
      font-size: 0.8rem;
      color: var(--text-muted);
      font-weight: 600;
      margin-top: 0.2rem;
    }

    /* Hero Showcase Image */
    .hero-image-wrap {
      position: relative;
    }
    .hero-main-card {
      background: #FFFFFF;
      border-radius: var(--radius-lg);
      overflow: hidden;
      box-shadow: var(--shadow-lg);
      border: 1px solid var(--border-subtle);
      position: relative;
    }
    .hero-main-card img {
      width: 100%;
      height: 420px;
      object-fit: cover;
      display: block;
      transition: transform 0.5s ease;
    }
    .hero-main-card:hover img {
      transform: scale(1.03);
    }
    .hero-badge-float {
      position: absolute;
      top: 1.25rem;
      left: 1.25rem;
      background: rgba(255, 255, 255, 0.95);
      backdrop-filter: blur(8px);
      padding: 0.5rem 1rem;
      border-radius: 9999px;
      font-size: 0.82rem;
      font-weight: 800;
      color: var(--primary-red);
      box-shadow: var(--shadow-md);
      display: flex;
      align-items: center;
      gap: 0.4rem;
    }
    .hero-card-footer {
      padding: 1.25rem 1.5rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      background: #FFFFFF;
    }
    .hero-card-name {
      font-size: 1.25rem;
      font-weight: 800;
      color: #111827;
    }
    .hero-card-sub {
      font-size: 0.85rem;
      color: var(--text-muted);
    }
    .hero-card-price {
      font-size: 1.5rem;
      font-weight: 800;
      color: var(--primary-red);
    }

    /* Floating Pill Badge */
    .float-feature {
      position: absolute;
      bottom: -1.2rem;
      right: 1.5rem;
      background: #FFFFFF;
      border: 1px solid var(--border-subtle);
      box-shadow: var(--shadow-lg);
      padding: 0.75rem 1.25rem;
      border-radius: var(--radius-md);
      display: flex;
      align-items: center;
      gap: 0.75rem;
      z-index: 10;
    }
    .float-icon {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      background: #FEF3C7;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.2rem;
    }

    /* Section Headers */
    .section-wrap {
      max-width: 1280px;
      margin: 0 auto;
      padding: 5rem 2rem 3rem;
    }
    .section-header {
      text-align: center;
      max-width: 720px;
      margin: 0 auto 3.5rem;
    }
    .section-tag {
      display: inline-block;
      font-size: 0.8rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      color: var(--primary-red);
      background: #FEE2E2;
      padding: 0.35rem 0.9rem;
      border-radius: 9999px;
      margin-bottom: 0.75rem;
    }
    .section-title {
      font-family: 'Playfair Display', serif;
      font-size: 2.75rem;
      font-weight: 700;
      color: #111827;
      letter-spacing: -0.02em;
      margin-bottom: 1rem;
      line-height: 1.2;
    }
    .section-desc {
      color: var(--text-muted);
      font-size: 1.1rem;
      line-height: 1.6;
    }

    /* Filter Bar */
    .filter-bar {
      display: flex;
      justify-content: center;
      gap: 0.75rem;
      flex-wrap: wrap;
      margin-bottom: 3rem;
    }
    .filter-btn {
      background: #FFFFFF;
      border: 1px solid var(--border-subtle);
      color: var(--text-muted);
      padding: 0.55rem 1.25rem;
      border-radius: 9999px;
      font-size: 0.9rem;
      font-weight: 700;
      cursor: pointer;
      transition: all 0.2s;
    }
    .filter-btn:hover, .filter-btn.active {
      background: var(--text-main);
      color: #FFFFFF;
      border-color: var(--text-main);
      box-shadow: var(--shadow-sm);
    }

    /* 10 Burgers Catalog Grid */
    .catalog-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
      gap: 2rem;
    }

    .burger-card {
      background: var(--bg-card);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-md);
      overflow: hidden;
      display: flex;
      flex-direction: column;
      box-shadow: var(--shadow-sm);
      transition: all 0.3s ease;
      position: relative;
    }
    .burger-card:hover {
      transform: translateY(-6px);
      box-shadow: var(--shadow-lg);
      border-color: var(--border-hover);
    }

    .burger-card-img-wrap {
      position: relative;
      width: 100%;
      height: 240px;
      background: #E5E7EB;
      overflow: hidden;
    }
    .burger-card-img-wrap img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transition: transform 0.4s ease;
    }
    .burger-card:hover .burger-card-img-wrap img {
      transform: scale(1.06);
    }

    /* Specialty Badge */
    .badge-specialty {
      position: absolute;
      top: 1rem;
      left: 1rem;
      padding: 0.35rem 0.85rem;
      border-radius: 9999px;
      font-size: 0.78rem;
      font-weight: 800;
      letter-spacing: 0.01em;
      box-shadow: 0 4px 10px rgba(0,0,0,0.12);
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      backdrop-filter: blur(8px);
    }

    .badge-rating {
      position: absolute;
      top: 1rem;
      right: 1rem;
      background: rgba(255, 255, 255, 0.95);
      backdrop-filter: blur(6px);
      padding: 0.3rem 0.65rem;
      border-radius: 9999px;
      font-size: 0.78rem;
      font-weight: 700;
      color: #111827;
      display: flex;
      align-items: center;
      gap: 0.25rem;
      box-shadow: 0 4px 8px rgba(0,0,0,0.08);
    }

    .burger-card-body {
      padding: 1.5rem;
      display: flex;
      flex-direction: column;
      flex: 1;
    }
    .burger-meta {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      font-size: 0.78rem;
      color: var(--text-muted);
      font-weight: 600;
      margin-bottom: 0.5rem;
    }
    .burger-title {
      font-size: 1.35rem;
      font-weight: 800;
      color: #111827;
      margin-bottom: 0.6rem;
      line-height: 1.25;
    }
    .burger-desc {
      color: var(--text-muted);
      font-size: 0.92rem;
      line-height: 1.55;
      margin-bottom: 1.25rem;
      flex: 1;
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .burger-footer {
      border-top: 1px solid var(--border-subtle);
      padding-top: 1.2rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem;
    }
    .burger-price-wrap {
      display: flex;
      flex-direction: column;
    }
    .burger-price-label {
      font-size: 0.72rem;
      color: var(--text-muted);
      font-weight: 700;
      text-transform: uppercase;
    }
    .burger-price {
      font-size: 1.6rem;
      font-weight: 800;
      color: var(--primary-red);
      letter-spacing: -0.02em;
    }

    .btn-detail {
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      color: #111827;
      padding: 0.55rem 1rem;
      border-radius: var(--radius-sm);
      font-size: 0.85rem;
      font-weight: 700;
      cursor: pointer;
      transition: all 0.2s;
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
    }
    .btn-detail:hover {
      background: #111827;
      color: #FFFFFF;
      border-color: #111827;
    }

    /* Modal / Drawer for Details */
    .modal-backdrop {
      display: none;
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      background: rgba(15, 23, 42, 0.6);
      backdrop-filter: blur(4px);
      z-index: 100;
      align-items: center;
      justify-content: center;
      padding: 1.5rem;
      opacity: 0;
      transition: opacity 0.25s ease;
    }
    .modal-backdrop.open {
      display: flex;
      opacity: 1;
    }
    .modal-box {
      background: #FFFFFF;
      border-radius: var(--radius-lg);
      max-width: 620px;
      width: 100%;
      max-height: 90vh;
      overflow-y: auto;
      box-shadow: 0 25px 60px -15px rgba(0,0,0,0.3);
      position: relative;
      border: 1px solid var(--border-subtle);
      animation: modalSlide 0.3s ease-out;
    }
    @keyframes modalSlide {
      from { transform: translateY(20px); opacity: 0; }
      to { transform: translateY(0); opacity: 1; }
    }
    .modal-img-wrap {
      width: 100%;
      height: 260px;
      position: relative;
      background: #000;
    }
    .modal-img-wrap img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .modal-close {
      position: absolute;
      top: 1rem;
      right: 1rem;
      background: rgba(255, 255, 255, 0.9);
      border: none;
      width: 36px;
      height: 36px;
      border-radius: 50%;
      font-size: 1.25rem;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: var(--shadow-md);
      transition: transform 0.2s;
    }
    .modal-close:hover {
      transform: scale(1.1);
    }
    .modal-body {
      padding: 1.75rem 2rem 2rem;
    }
    .modal-badge {
      display: inline-block;
      padding: 0.35rem 0.85rem;
      border-radius: 9999px;
      font-size: 0.8rem;
      font-weight: 800;
      margin-bottom: 0.75rem;
    }
    .modal-title {
      font-family: 'Playfair Display', serif;
      font-size: 2rem;
      font-weight: 700;
      color: #111827;
      margin-bottom: 0.5rem;
    }
    .modal-price-tag {
      font-size: 1.8rem;
      font-weight: 800;
      color: var(--primary-red);
      margin-bottom: 1.25rem;
    }
    .modal-section-title {
      font-size: 0.85rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--text-muted);
      margin-bottom: 0.4rem;
      margin-top: 1.2rem;
    }
    .modal-text {
      color: #374151;
      font-size: 0.98rem;
      line-height: 1.6;
    }
    .modal-pill-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 0.75rem;
      margin: 1.25rem 0;
      background: var(--bg-surface);
      padding: 1rem;
      border-radius: var(--radius-sm);
    }
    .modal-pill-item {
      font-size: 0.85rem;
    }
    .modal-pill-item strong {
      display: block;
      color: #111827;
      font-size: 0.9rem;
    }
    .modal-pill-item span {
      color: var(--text-muted);
    }
    .modal-cta-row {
      display: flex;
      gap: 1rem;
      margin-top: 2rem;
      padding-top: 1.5rem;
      border-top: 1px solid var(--border-subtle);
    }

    /* Brand Pillars / Features */
    .pillars-section {
      background: #FFFFFF;
      border-top: 1px solid var(--border-subtle);
      border-bottom: 1px solid var(--border-subtle);
      padding: 5rem 2rem;
    }
    .pillars-grid {
      max-width: 1280px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 2rem;
    }
    .pillar-card {
      padding: 1.75rem;
      background: var(--bg-primary);
      border-radius: var(--radius-md);
      border: 1px solid var(--border-subtle);
      text-align: left;
    }
    .pillar-icon {
      font-size: 2.2rem;
      margin-bottom: 1rem;
      display: inline-block;
    }
    .pillar-title {
      font-size: 1.15rem;
      font-weight: 800;
      color: #111827;
      margin-bottom: 0.5rem;
    }
    .pillar-desc {
      color: var(--text-muted);
      font-size: 0.9rem;
      line-height: 1.6;
    }

    /* App Promotion Banner */
    .app-promo-wrap {
      max-width: 1280px;
      margin: 5rem auto;
      padding: 0 2rem;
    }
    .app-promo-card {
      background: linear-gradient(135deg, #18181B 0%, #27272A 100%);
      border-radius: var(--radius-lg);
      padding: 4rem;
      color: white;
      display: grid;
      grid-template-columns: 1.2fr 0.8fr;
      align-items: center;
      gap: 3rem;
      position: relative;
      overflow: hidden;
    }
    .app-promo-card::before {
      content: '';
      position: absolute;
      top: -50px;
      right: -50px;
      width: 300px;
      height: 300px;
      background: radial-gradient(circle, rgba(220, 38, 38, 0.35) 0%, transparent 70%);
      border-radius: 50%;
    }
    .app-promo-card h2 {
      font-family: 'Playfair Display', serif;
      font-size: 2.75rem;
      font-weight: 700;
      line-height: 1.2;
      margin-bottom: 1rem;
    }
    .app-promo-card p {
      color: #A1A1AA;
      font-size: 1.1rem;
      line-height: 1.6;
      margin-bottom: 2rem;
      max-width: 520px;
    }
    .app-features-list {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
      margin-bottom: 2.25rem;
    }
    .app-features-list li {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      font-weight: 600;
      color: #E4E4E7;
      font-size: 0.95rem;
    }
    .app-features-list span {
      color: #4ADE80;
    }

    .app-mockup-frame {
      background: rgba(255, 255, 255, 0.08);
      border: 1px solid rgba(255, 255, 255, 0.15);
      border-radius: 28px;
      padding: 1.75rem;
      text-align: center;
      backdrop-filter: blur(10px);
      box-shadow: 0 25px 50px rgba(0,0,0,0.5);
    }
    .app-mockup-screen {
      background: #FFFFFF;
      border-radius: 18px;
      padding: 1.75rem 1.25rem;
      color: #111827;
      text-align: left;
    }

    /* Footer */
    footer {
      background: #FFFFFF;
      border-top: 1px solid var(--border-subtle);
      padding: 4rem 2rem 2rem;
    }
    .footer-inner {
      max-width: 1280px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: 1.5fr 1fr 1fr 1fr;
      gap: 3rem;
      margin-bottom: 3rem;
    }
    .footer-brand p {
      color: var(--text-muted);
      font-size: 0.92rem;
      line-height: 1.6;
      margin-top: 1rem;
      max-width: 320px;
    }
    .footer-col h4 {
      font-size: 0.95rem;
      font-weight: 800;
      color: #111827;
      margin-bottom: 1.25rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }
    .footer-col ul {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }
    .footer-col a {
      color: var(--text-muted);
      text-decoration: none;
      font-size: 0.9rem;
      transition: color 0.2s;
    }
    .footer-col a:hover {
      color: var(--primary-red);
    }
    .footer-bottom {
      max-width: 1280px;
      margin: 0 auto;
      border-top: 1px solid var(--border-subtle);
      padding-top: 2rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      color: var(--text-muted);
      font-size: 0.85rem;
      flex-wrap: wrap;
      gap: 1rem;
    }

    /* Responsive */
    @media (max-width: 992px) {
      .hero {
        grid-template-columns: 1fr;
        padding-top: 2.5rem;
      }
      .pillars-grid {
        grid-template-columns: repeat(2, 1fr);
      }
      .app-promo-card {
        grid-template-columns: 1fr;
        padding: 2.5rem;
      }
      .footer-inner {
        grid-template-columns: 1fr 1fr;
      }
    }
    @media (max-width: 640px) {
      .hero h1 {
        font-size: 2.6rem;
      }
      .pillars-grid {
        grid-template-columns: 1fr;
      }
      .footer-inner {
        grid-template-columns: 1fr;
      }
      .nav-links {
        display: none;
      }
    }
  </style>
</head>
<body>

  <!-- Top Announcement Bar -->
  <div class="top-bar">
    <span>👑 <strong>Hamburger Rapid:</strong> La primera versión comercial ya está disponible en vivo.</span>
    <span>•</span>
