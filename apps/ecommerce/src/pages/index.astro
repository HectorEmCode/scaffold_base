        </div>
        <div>
          <div class="stat-number">4.95 ★</div>
          <div class="stat-label">Satisfacción Gourmet</div>
        </div>
        <div>
          <div class="stat-number">&lt; 25 min</div>
          <div class="stat-label">Entrega Rapid Express</div>
        </div>
      </div>
    </div>

    <!-- Hero Card Showcase -->
    <div class="hero-image-wrap">
      <div class="hero-main-card">
        <span class="hero-badge-float">
          <span>👑</span> Especialidad Suprema del Rey
        </span>
