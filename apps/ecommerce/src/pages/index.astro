        <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
          <a href="/app" class="btn-primary" style="background: #DC2626; padding: 0.85rem 1.75rem;">
            <span>📲</span> Abrir PWA Mobile Ahora
          </a>
          <a href="/admin" class="btn-secondary" style="background: rgba(255,255,255,0.1); color: white; border-color: rgba(255,255,255,0.2);">
