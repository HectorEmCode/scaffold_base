        <h4>Ecosistema</h4>
        <ul>
          <li><a href="/">Landing E-commerce</a></li>
          <li><a href="/app">PWA Mobile (Clientes)</a></li>
          <li><a href="/admin">Panel Administrativo</a></li>
          <li><a href="/api/health">Health Check API</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h4>Top Especialidades</h4>
        <ul>
          <li><a href="#catalogo">Rey de las Burgers</a></li>
          <li><a href="#catalogo">Burger Real Clásica</a></li>
          <li><a href="#catalogo">Burger Real Doble</a></li>
          <li><a href="#catalogo">Burger Doble Especial</a></li>
          <li><a href="#catalogo">Burger Trufada Imperial</a></li>
