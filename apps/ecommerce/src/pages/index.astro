        Desde las legendarias recetas clásicas hasta nuestras especialidades de la realeza. Cada una creada con ingredientes de máxima especialidad y balance culinario.
      </p>
    </div>

    <!-- Categories Filter Bar -->
    <div class="filter-bar">
      <button class="filter-btn active" data-filter="all">Todas (10)</button>
      <button class="filter-btn" data-filter="Especiales">Especiales del Rey</button>
      <button class="filter-btn" data-filter="Clasicas">Clásicas</button>
      <button class="filter-btn" data-filter="Dobles">Dobles a la Brasa</button>
      <button class="filter-btn" data-filter="Gourmet">Alta Cocina</button>
      <button class="filter-btn" data-filter="Pollo">Pollo Crocante</button>
      <button class="filter-btn" data-filter="Veggie">Gourmet Veggie</button>
    </div>

    <!-- 10 Burgers Grid -->
    <div class="catalog-grid" id="burgersGrid">
      {featuredBurgers.map((burger) => (
        <article class="burger-card" data-category={burger.category} data-id={burger.id}>
          <div class="burger-card-img-wrap">
            <span class="badge-specialty" style={`background-color: ${burger.badgeBg}; color: ${burger.badgeColor};`}>
              {burger.specialtyLevel}
            </span>
            <span class="badge-rating">
              ★ {burger.rating}
            </span>
            <img src={burger.image} alt={burger.name} loading="lazy" />
          </div>

          <div class="burger-card-body">
            <div class="burger-meta">
              <span>⏱️ {burger.prepTime}</span>
              <span>•</span>
              <span>🔥 {burger.calories}</span>
            </div>

            <h3 class="burger-title">{burger.name}</h3>
            <p class="burger-desc">{burger.description}</p>

            <div class="burger-footer">
              <div class="burger-price-wrap">
                <span class="burger-price-label">Precio</span>
                <span class="burger-price">${burger.price.toFixed(2)}</span>
              </div>

              <button 
                class="btn-detail open-modal-btn" 
                data-name={burger.name}
                data-price={burger.price.toFixed(2)}
                data-specialty={burger.specialtyLevel}
                data-specialty-bg={burger.badgeBg}
                data-specialty-color={burger.badgeColor}
                data-image={burger.image}
                data-desc={burger.description}
                data-ingredients={burger.ingredients}
                data-allergens={burger.allergens}
                data-pairing={burger.pairing}
                data-time={burger.prepTime}
                data-cal={burger.calories}
                data-rating={burger.rating}
              >
                <span>🔍</span> Ver detalles
              </button>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- PWA Promotion Section -->
  <section class="app-promo-wrap" id="especialidades">
    <div class="app-promo-card">
      <div>
        <div style="display: inline-block; background: rgba(220, 38, 38, 0.2); color: #FCA5A5; font-size: 0.8rem; font-weight: 800; padding: 0.35rem 0.8rem; border-radius: 9999px; margin-bottom: 1rem; border: 1px solid rgba(220, 38, 38, 0.4);">
