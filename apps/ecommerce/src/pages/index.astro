          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
            <strong style="font-size: 0.9rem; color: #DC2626;">📱 Hamburger Rapid PWA</strong>
            <span style="font-size: 0.72rem; background: #DCFCE7; color: #15803D; padding: 2px 8px; border-radius: 8px; font-weight: 700;">🟢 En Línea</span>
          </div>
          <div style="font-size: 0.85rem; font-weight: 800; margin-bottom: 0.4rem;">Simulación de Compra</div>
          <p style="font-size: 0.75rem; color: #6B7280; margin-bottom: 1rem;">Tu orden de "Rey de las Burgers" + papas trufadas está lista para ser enviada a la parrilla.</p>
          <a href="/app" style="display: block; text-align: center; background: #DC2626; color: white; padding: 0.6rem; border-radius: 8px; font-size: 0.82rem; font-weight: 700; text-decoration: none;">
            Comenzar Simulación &rarr;
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Interactive Details Modal -->
  <div class="modal-backdrop" id="detailModal">
    <div class="modal-box">
      <div class="modal-img-wrap">
        <button class="modal-close" id="closeModalBtn">&times;</button>
        <img id="modalImg" src="" alt="Hamburguesa Detalle" />
      </div>
      <div class="modal-body">
        <span class="modal-badge" id="modalBadge"></span>
        <h3 class="modal-title" id="modalTitle"></h3>
        <div class="modal-price-tag" id="modalPrice"></div>

        <div class="modal-section-title">Descripción de la Receta</div>
        <p class="modal-text" id="modalDesc"></p>

        <div class="modal-pill-grid">
          <div class="modal-pill-item">
            <span>Tiempo de Cocción</span>
            <strong id="modalTime"></strong>
          </div>
          <div class="modal-pill-item">
            <span>Calorías Aproximadas</span>
            <strong id="modalCal"></strong>
          </div>
          <div class="modal-pill-item">
            <span>Puntuación de Clientes</span>
            <strong id="modalRating"></strong>
          </div>
          <div class="modal-pill-item">
            <span>Alérgenos Presentes</span>
            <strong id="modalAllergens"></strong>
          </div>
        </div>

        <div class="modal-section-title">Ingredientes de Alta Calidad</div>
        <p class="modal-text" id="modalIngredients" style="font-size: 0.9rem; color: #4B5563;"></p>

        <div class="modal-section-title">Maridaje Recomendado</div>
        <p class="modal-text" id="modalPairing" style="font-size: 0.9rem; color: #B45309; font-weight: 600;"></p>

        <div class="modal-cta-row">
          <a href="/app" class="btn-primary" style="flex: 1; justify-content: center; padding: 0.85rem;">
            <span>🍔</span> Pedir en PWA Mobile
          </a>
          <button class="btn-secondary" id="closeModalBtn2">
            Cerrar
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Footer -->
  <footer>
    <div class="footer-inner">
      <div class="footer-brand">
        <div class="brand-wrap">
          <div class="brand-icon">🍔</div>
